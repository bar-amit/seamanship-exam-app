{
  "name": "seamanship-exam-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --test",
    "validate:env:staging": "node --env-file=.env.staging scripts/validate-env.js --env=staging",
    "validate:env:prod": "node --env-file=.env.production scripts/validate-env.js --env=prod",
    "import:phase2:staging:dry": "node --env-file=.env.staging scripts/import-phase2.js --dry-run --skip-upload --skip-firestore",
    "import:phase2:staging": "node --env-file=.env.staging scripts/import-phase2.js",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "import:phase2:dry": "node --env-file=.env.local scripts/import-phase2.js --dry-run --skip-upload --skip-firestore",
    "import:phase2": "node --env-file=.env.local scripts/import-phase2.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0"
  },
  "dependencies": {
    "firebase": "^11.1.0",
    "firebase-admin": "^13.0.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
